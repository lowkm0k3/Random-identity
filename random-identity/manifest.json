{
  "manifest_version": 3,
  "name": "Random Identity",
  "version": "1.1",
  "description": "Generate a readable random username and a strong random password.",
  "action": {
    "default_title": "Random Identity",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["generator.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "random-identity@m0k3.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {}
  }
}